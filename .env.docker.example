# Copy to `.env` next to docker-compose.yml to override compose defaults.
# All values below are OPTIONAL — the stack runs with safe defaults if unset.

# Host port for the quarantined legacy VAP web app. Compose always publishes
# it on 127.0.0.1; use the authenticated native AEGIS API for network access.
VAP_PORT=8000

# Live scanning is OFF by default. Enable ONLY with documented authorization
# AND the scanner binaries present (use docker-compose.scanners.yml).
VAP_ENABLE_LIVE_SCANS=false

# Secrets for production (leave blank locally; NEVER commit real values).
# VAP_API_KEY=
# VAP_JWT_SECRET=
# VAP_CSRF_SECRET=
# Force HTTPS in production:
# VAP_REQUIRE_HTTPS=true
