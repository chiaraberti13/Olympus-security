# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# Secrets / env — NEVER commit
.env
*.pem
*.key
# OS
.DS_Store

# Vendored-tool runtime artifacts (source is committed; runtime state is not)
vendor/**/vap.db
vendor/**/vap.db-*
vendor/**/*.sqlite
vendor/**/reports/*
!vendor/**/reports/.gitkeep
vendor/**/scans/*
!vendor/**/scans/.gitkeep
vendor/**/.venv/
