# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# Secrets / env — NEVER commit
.env
*.pem
*.key
# OS
.DS_Store

# Default report names. Reports default to a plain filename in the working
# directory, so running the CLI from a checkout drops them at the repo root.
# They are outputs of a demo run, never sources.
/apollo-alerts.json
/argus-assets.json
/argus-dns.json
/argus-email.json
/argus-fronting.json
/argus-investigation.json
/argus-web.json
/argus-whois.json
/helios-findings.json
/hermes-results.sarif
/minerva-custody.json
/minerva-incident.json
/proteus-campaign.json
/proteus-training.html
/vulcan-report.json
/vulcan-report.md
/vulcan-report.html

# Vendored-tool runtime artifacts (source is committed; runtime state is not)
vendor/**/vap.db
vendor/**/vap.db-*
vendor/**/*.sqlite
vendor/**/reports/*
!vendor/**/reports/.gitkeep
vendor/**/scans/*
!vendor/**/scans/.gitkeep
vendor/**/.venv/
